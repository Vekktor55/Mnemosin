{
  "name": "@mnemosin/client",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Клиент МНЕМОСИН (промпт 1.12): Svelte 5 + Vite, WS-клиент, stores, UI игрока и GM. Типы — только из @mnemosin/contracts (D103, инвариант 15).",
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist-types/src/index.d.ts",
      "default": "./dist-types/src/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "check": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@mnemosin/contracts": "*"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tsconfig/svelte": "^5.0.8",
    "svelte": "^5.46.4",
    "svelte-check": "^4.7.6",
    "vite": "^8.0.0"
  }
}
