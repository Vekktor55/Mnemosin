# МНЕМОСИН — переменные окружения (v3 §VIII.8, docs/SPEC_STAGE1.md §11)
# Скопируйте в .env и заполните. .env в git НЕ попадает.
# Секреты — только здесь. В конфиги config/*.yaml и в код — нельзя.

# --- обязательно -----------------------------------------------------------
# Путь к SQLite. Относительный — от корня проекта (или MNEMOSIN_HOME).
DATABASE_URL=file:./data/mnemosin.sqlite

# Минимум 32 символа. Сгенерировать:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# --- сервер ------------------------------------------------------------------
NODE_ENV=development            # development | test | stage | production
PORT=3000
METRICS_PORT=9464               # /metrics в production отдаётся только здесь
# CORS_ORIGIN=                  # в production обязателен; список через запятую
# MNEMOSIN_HOME=                # корень проекта, если запуск не из корня

# --- логирование -------------------------------------------------------------
LOG_LEVEL=info                  # fatal|error|warn|info|debug|trace|silent
LOG_REDACT_PLAYER_TEXT=1        # 1 → текст игроков маскируется в логах

# --- JWT ---------------------------------------------------------------------
JWT_TTL_SECONDS=43200           # 12 часов
JWT_REFRESH_TTL_SECONDS=2592000 # 30 дней

# --- AI (этап 1: только офлайн-стенды) ---------------------------------------
AI_PROVIDER=scripted            # scripted | echo | failing   (этап 2: openrouter | lmstudio)
AI_SCRIPTED_FIXTURE=tools/fixtures/resolution.ok.json
AI_FAILING_MODE=timeout         # timeout | schema | rate_limit | unavailable
# OPENROUTER_API_KEY=           # этап 2 (промпт 2.6)
# LMSTUDIO_BASE_URL=            # этап 2 (промпт 2.7), обычно http://127.0.0.1:1234/v1

# --- Media (этап 1: none) ----------------------------------------------------
MEDIA_PROVIDER=none             # none | debug (2.11) | comfyui (2.12)
# HOSTBRIDGE_SECRET=            # обязателен (>=32) при MEDIA_PROVIDER=comfyui

# --- каталоги ----------------------------------------------------------------
CONFIG_DIR=./config
STATE_DIR=./data/state
